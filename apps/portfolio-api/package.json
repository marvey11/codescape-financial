{
  "name": "@codescape-financial/portfolio-api",
  "version": "0.0.1",
  "private": true,
  "dependencies": {
    "@codescape-financial/historical-data-access": "*",
    "@codescape-financial/portfolio-config": "*",
    "@codescape-financial/portfolio-data-access": "*",
    "@codescape-financial/portfolio-data-models": "*",
    "@nestjs/config": "^12.0.0",
    "@nestjs/cache-manager": "^12.0.0",
    "@nestjs/typeorm": "^12.0.1",
    "cache-manager": "^7.2.9",
    "class-transformer": "^0.5.1",
    "pg": "^8.23.0",
    "typeorm": "^1.1.0"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "@nx/webpack:webpack",
        "outputs": [
          "{options.outputPath}"
        ],
        "defaultConfiguration": "production",
        "options": {
          "target": "node",
          "compiler": "tsc",
          "outputPath": "dist/apps/portfolio-api",
          "main": "apps/portfolio-api/src/main.ts",
          "tsConfig": "apps/portfolio-api/tsconfig.app.json",
          "webpackConfig": "apps/portfolio-api/webpack.config.js"
        },
        "configurations": {
          "development": {
            "optimization": false,
            "extractLicenses": false
          },
          "production": {
            "optimization": true,
            "extractLicenses": true
          }
        }
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "@codescape-financial/portfolio-api:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@codescape-financial/portfolio-api:build:development"
          },
          "production": {
            "buildTarget": "@codescape-financial/portfolio-api:build:production"
          }
        }
      },
      "test": {
        "options": {
          "passWithNoTests": true
        }
      }
    }
  }
}
