{
  "name": "@codescape-financial/csv-processor",
  "version": "0.0.1",
  "dependencies": {
    "@codescape-financial/core": "*",
    "@codescape-financial/portfolio-config": "*",
    "@codescape-financial/historical-data-access": "*"
  },
  "nx": {
    "targets": {
      "build": {
        "defaultConfiguration": "production",
        "configurations": {
          "production": {
            "env": {
              "NODE_ENV": "production"
            }
          }
        }
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "@codescape-financial/portfolio-csv-processor:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@codescape-financial/portfolio-csv-processor:build:development"
          },
          "production": {
            "buildTarget": "@codescape-financial/portfolio-csv-processor:build:production"
          }
        }
      },
      "test": {
        "options": {
          "passWithNoTests": true
        }
      }
    },
    "name": "@codescape-financial/portfolio-csv-processor"
  }
}
