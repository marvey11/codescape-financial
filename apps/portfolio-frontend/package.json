{
  "name": "@codescape-financial/portfolio-frontend",
  "version": "0.0.1",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json"
  },
  "dependencies": {
    "@codescape-financial/core-ui": "*",
    "@codescape-financial/portfolio-data-models": "*"
  },
  "devDependencies": {},
  "nx": {
    "name": "portfolio-frontend",
    "projectType": "application",
    "targets": {
      "typecheck": {
        "executor": "nx:run-commands",
        "options": {
          "command": "tsc --noEmit -p apps/portfolio-frontend/tsconfig.app.json"
        }
      }
    }
  }
}
