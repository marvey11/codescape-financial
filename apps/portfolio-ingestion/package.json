{
  "name": "@codescape-financial/portfolio-ingestion",
  "version": "0.0.1",
  "private": true,
  "dependencies": {
    "@codescape-financial/core": "*",
    "@codescape-financial/historical-data-access": "*",
    "@codescape-financial/portfolio-config": "*",
    "@codescape-financial/portfolio-data-access": "*",
    "@codescape-financial/portfolio-data-models": "*",
    "csv-parser": "^3.2.1"
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "@nx/webpack:webpack",
        "outputs": [
          "{options.outputPath}"
        ],
        "defaultConfiguration": "production",
        "options": {
          "target": "node",
          "compiler": "tsc",
          "outputPath": "dist/apps/portfolio-ingestion",
          "main": "apps/portfolio-ingestion/src/main.ts",
          "tsConfig": "apps/portfolio-ingestion/tsconfig.app.json",
          "webpackConfig": "apps/portfolio-ingestion/webpack.config.js"
        },
        "configurations": {
          "development": {
            "optimization": false,
            "extractLicenses": false
          },
          "production": {
            "optimization": true,
            "extractLicenses": true
          }
        }
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "@codescape-financial/portfolio-ingestion:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@codescape-financial/portfolio-ingestion:build:development"
          },
          "production": {
            "buildTarget": "@codescape-financial/portfolio-ingestion:build:production"
          }
        }
      },
      "test": {
        "options": {
          "passWithNoTests": true
        }
      }
    }
  }
}
