{
  "name": "@codescape-financial/source",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "affected:check": "nx affected -t typecheck -t build -t lint -t test",
    "check:all": "nx run-many -t typecheck -t build -t lint -t test",
    "typeorm": "ts-node --compiler-options '{\"module\":\"node16\", \"moduleResolution\": \"node16\"}' -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migration:generate": "yarn typeorm -- -d ./apps/portfolio-api/src/data-source.ts migration:generate",
    "migration:run": "yarn typeorm -- -d ./apps/portfolio-api/src/data-source.ts migration:run",
    "migration:revert": "yarn typeorm -- -d ./apps/portfolio-api/src/data-source.ts migration:revert"
  },
