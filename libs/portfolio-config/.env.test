# Test Environment Variables for the portfolio-config library.
# This file is loaded by the config.service.test.ts suite.

# REST API
API_PORT=4000
API_PREFIX=test-api

# Database
DATABASE_HOST=test-db-host
DATABASE_PORT=5433
DATABASE_NAME=test_db_name
DATABASE_USER=test_user
DATABASE_PASSWORD=test_password

# The ID of the portfolio to which any transactions parsed from CSV will be added to
DEFAULT_PORTFOLIO_ID=f1ca5bbe-5f34-46af-8397-e30ee35da452

BASE_DATA_DIR=./test_data

QUOTES_DATA_DIR=${BASE_DATA_DIR}/quotes
QUOTES_PROCESSED_DIR=${QUOTES_DATA_DIR}/processed
QUOTES_ERRORS_DIR=${QUOTES_DATA_DIR}/errors

PORTFOLIO_DATA_DIR=${BASE_DATA_DIR}/portfolio
CSV_TRANSACTIONS_INPUT_DIR=${PORTFOLIO_DATA_DIR}/transactions
JSON_DIVIDENDS_INPUT_FILE=${PORTFOLIO_DATA_DIR}/dividend-data.json
JSON_STOCK_SPLITS_INPUT_FILE=${PORTFOLIO_DATA_DIR}/stock-split-data.json
